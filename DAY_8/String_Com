import java.util.*;
class Student 
{
    int rollNo;
    String name, phNo;
    Student(int rollNo, String name, String phNo) 
    {
        this.rollNo = rollNo;
        this.name = name;
        this.phNo = phNo;
    }
    public String toString() 
    {
        return rollNo + " " + name + " " + phNo;
    }
}
class SortByRollNo implements Comparator<Student> 
{
    public int compare(Student s1, Student s2) 
    {
        return Integer.compare(s1.rollNo, s2.rollNo);
    }
}
public class Main 
{
	public static void main(String[] args) 
	{
		List<Student> arr = new ArrayList<>();
		arr.add(new Student(1, "shan", "12345"));
		arr.add(new Student(4, "zyx", "12345789"));
		arr.add(new Student(2, "abc", "123"));
		arr.add(new Student(3, "wert", "12345789"));
		Collections.sort(arr, new SortByRollNo());
		for(Student s: arr)
		{
		    System.out.println(s);
		}
	}
}
