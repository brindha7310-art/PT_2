import java.util.*;
abstract class ClassOne 
{
    abstract void fun1();
    void fun2() 
    {
        System.out.println("I am in ClassOne");
    }
}
class ClassTwo extends ClassOne
{
    void fun1() 
    {
        System.out.println("I am in ClassTwo");
    }
}
public class Main 
{
	public static void main(String[] args) 
	{
		ClassOne obj = new ClassTwo();
		obj.fun1();
	}
}
