import java.util.*;
public class Main 
{
	public static void main(String[] args) 
	{
		Scanner sc = new Scanner(System.in);
		String str = sc.next();
		int max = 0, pos = 0;
		for(int i=0;i<str.length();i++) 
		{
		    int cnt = 1;
		    for(int j=i+1;j<str.length();j++) 
		    {
		        if(str.charAt(i) == str.charAt(j))
		        {
		            cnt++;
		        }
		    }
		    if(max < cnt) 
		    {
		        max = cnt;
		        pos = i;
		    }
		}
		System.out.print(str.charAt(pos) + " " + pos + " " + max);
	}
}
