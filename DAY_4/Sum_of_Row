import java.util.*;
public class Main 
{
	public static void main(String[] args) 
	{
		Scanner sc = new Scanner(System.in);
		int R = sc.nextInt(), sum1 = 0, sum2 = 0;
		int C = sc.nextInt(), row, col;
		int mat[][] = new int[R][C];
		for(row=0;row<R;row++)
		{
		    for(col=0;col<C;col++)
		    {
		        mat[row][col] = sc.nextInt();
		    }
		}
		for(row=0;row<R;row++) 
		{
		    for(col=0;col<C;col++) 
		    {
		        if(row  == col)
		        {
		            sum1 += mat[row][col];
		        }
		        if(row+col == C-1)
		        {
		            sum2 += mat[row][col];
		        }
		    }
		}
		System.out.print(sum1 + " " + sum2);
	}
}
