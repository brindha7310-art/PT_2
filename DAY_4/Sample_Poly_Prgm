import java.util.*;
public class Main 
{
    static void fun(int a, int b)
    {
        System.out.println(a+b);
    }
    
    static void fun(int a, int b, int c)
    {
        System.out.println(a+b+c);
    }
    
	public static void main(String[] args) 
	{
		fun(10, 20);
		fun(10, 20, 30);
	}
}
