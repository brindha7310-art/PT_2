mport java.util.*;

class Bank {
    int bal = 1000;
    
    synchronized void withDraw(int amt) {
        if(bal >= amt) {
            System.out.print(Thread.currentThread().getName() + " ");
            bal = bal - amt;
            System.out.println(bal);
        }
        else {
            System.out.println("Insufficient Balance");
        }
    }
}

class ClassOne extends Thread{
    Bank bank;
    
    ClassOne(Bank b) {
        bank = b;
    }
    
    public void run() {
        bank.withDraw(800);
    }
}

public class Main {
	public static void main(String[] args) {
	    Bank bankObj = new Bank();
		ClassOne obj1 = new ClassOne(bankObj);
		ClassOne obj2 = new ClassOne(bankObj);
		obj1.setName("First Object");
		obj2.setName("Second Object");
		obj1.start();
		obj2.start();
	}
}
